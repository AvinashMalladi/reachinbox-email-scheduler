# ─── Core ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database (PostgreSQL) ──────────────────────────────
# Host port 55432 -> container 5432 (host ports 5432/5433 are often occupied by
# a local Postgres or Docker relays; adjust if you hit a port conflict).
DATABASE_URL=postgres://reachinbox:reachinbox@localhost:55432/reachinbox

# ─── Redis (BullMQ backbone) ────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=

# ─── Auth ───────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
# Create an OAuth consent screen at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Optional dev-only login (used when no Google client is configured). Set false for production.
ENABLE_DEMO_LOGIN=false

# ─── Slack ──────────────────────────────────────────────
# Create an app at https://api.slack.com/apps with bot scopes: chat:write, channels:read
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
# Optional: deep-link the "Connect Slack" flow into a specific workspace so new users
# skip Slack's "enter your workspace URL" screen and go straight to signing in to it.
# SLACK_TEAM_DOMAIN=reachinbox-x8j2771

# ─── Cross-deployment OAuth relay (optional) ─────────────
# Google OAuth clients and Slack apps allow only an EXACT match on redirect_uri, so a
# single origin holds the URIs actually registered in the consoles ("anchor"). If a
# second deployment runs on a different origin ("peer"), set both origins on both
# instances and the peer's login flows start through the anchor's registered callback,
# which transparently forwards the code+state back. Leave unset for a single origin.
# OAUTH_REGISTERED_ORIGIN=https://app-a.example.com
# OAUTH_PEER_ORIGIN=https://app-b.example.com

# ─── Ethereal SMTP senders ──────────────────────────────
# 1) Explicit multi-sender list (create accounts at https://ethereal.email -> Create
#    Ethereal Account, then paste). Format: user:pass,user:pass  (one per sender).
#    This is the *reliable* way to demo multiple senders.
# ETHEREAL_SENDERS=account1-user@ethereal.email:account1-pass,account2-user@ethereal.email:account2-pass
# 2) Single existing account:
# ETHEREAL_USER=
# ETHEREAL_PASSWORD=
# 3) Auto-provision N throwaway accounts via the Ethereal API at boot (fast repeated
#    createTestAccount calls can return duplicate accounts, so prefer option 1).
ETHEREAL_SENDERS_COUNT=3
# SMTP port used for Ethereal delivery. Ethereal is the PRIMARY mailer — it is always
# tried first; the Brevo fallback below only engages when Ethereal's SMTP is unreachable.
# ETHEREAL_SMTP_PORT=587

# ─── Optional Brevo REST delivery (port 443) ─────────────
# AUTO-FALLBACK — only used when the boot-time probe finds Ethereal SMTP unreachable
# (e.g. Render free tier blocks all outbound ports: 587/465/2525 all time out). Ethereal
# is always tried first. Create a free account at https://brevo.com -> SMTP & API ->
# API keys (master key).
# BREVO_API_KEY=xkeysib-xxxxxxxx...
# EMAIL_FALLBACK_FROM=you@example.com   (verified sender used for the fallback path)

# ─── Worker scheduling / throttling ─────────────────────
# Minimum delay between any two sends (provider throttling simulation)
MIN_DELAY_BETWEEN_SENDS_MS=2000
# How many jobs may be processed concurrently in one worker
WORKER_CONCURRENCY=5
# Hourly caps (per sender and global). Values below the UI override when scheduling.
MAX_EMAILS_PER_HOUR_PER_SENDER=50
MAX_EMAILS_PER_HOUR_GLOBAL=200

# ─── Elasticsearch ──────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ES_ENABLED=true